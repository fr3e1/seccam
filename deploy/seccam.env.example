# SecCam Environment Configuration
# Copy to /etc/seccam/seccam.env and adjust as needed
# All values are optional; defaults shown in comments

# Authentication
# SECCAM_PIN=                        # 4-12 digit PIN for login (optional; if unset, first-run setup via web UI)
# SECCAM_SECRET=                     # Session signing secret (auto-generated if empty, stored in DATA_DIR/secret)

# Storage
# SECCAM_DATA_DIR=/var/lib/seccam    # Data directory for snapshots, DB, secret (default: ./data)
# SECCAM_RETENTION_DAYS=14           # Days to keep events/snapshots (default: 14)

# Model
# SECCAM_MODEL_PATH=/opt/seccam/models/yolox_nano.onnx  # Path to ONNX model (default: ./models/yolox_nano.onnx)

# Network
# SECCAM_HOST=0.0.0.0                # Bind address (default: 0.0.0.0)
# SECCAM_HTTPS_PORT=443              # HTTPS port (default: 8443 dev, 443 prod)
# SECCAM_HTTP_PORT=80                # HTTP redirect port (default: 8080 dev, 80 prod)

# TLS (required for production; if CERT/KEY empty, serves plain HTTP on HTTPS_PORT - dev only)
# SECCAM_CERT=/etc/seccam/tls/server.crt
# SECCAM_KEY=/etc/seccam/tls/server.key
# SECCAM_CA_CERT=/etc/seccam/tls/ca.crt

# Static files
# SECCAM_STATIC_DIR=/opt/seccam/static  # Path to static/ directory (default: ./static)
