# SecCam environment configuration
# Copy to /etc/seccam/seccam.env (install.sh does this for you). All values are optional.

# Authentication
# SECCAM_PIN=                        # legacy v1 credential, only used to migrate a v1 install
# SECCAM_SECRET=                     # reserved; auto-generated and stored in DATA_DIR/secret
# SECCAM_SESSION_TTL_DAYS=30         # session lifetime, 1-365

# Storage
# SECCAM_DATA_DIR=/var/lib/seccam
# SECCAM_RETENTION_DAYS=14

# Model and static files (defaults follow /opt/seccam/current; do not point them into /opt/seccam/releases)
# SECCAM_MODEL_PATH=
# SECCAM_STATIC_DIR=

# Network. The main listener always uses SECCAM_HTTPS_PORT: TLS when SECCAM_CERT and SECCAM_KEY are set,
# plain HTTP otherwise (only for loopback behind a reverse proxy, or for development).
# SECCAM_HOST=0.0.0.0
# SECCAM_HTTPS_PORT=443
# SECCAM_HTTP_PORT=80                # redirect listener (serves /ca.crt)
# SECCAM_CERT=/etc/seccam/tls/server.crt
# SECCAM_KEY=/etc/seccam/tls/server.key
# SECCAM_CA_CERT=/etc/seccam/tls/ca.crt

# Reverse proxy / internet hosting (see README). Behind a proxy set ALL of these and leave CERT/KEY unset:
# SECCAM_HOST=127.0.0.1
# SECCAM_HTTPS_PORT=8443
# SECCAM_TRUSTED_PROXIES=127.0.0.1   # comma-separated IPs/CIDRs allowed to set X-Forwarded-*
# SECCAM_PUBLIC_ORIGIN=https://cam.example.com   # MANDATORY behind a proxy: the exact public origin, no trailing path
# SECCAM_COOKIE_SECURE=true          # auto | true | false

# Web updater
# SECCAM_UPDATE_MODE=systemd         # off | systemd (install.sh sets systemd)
# SECCAM_UPDATE_REPO=fr3e1/seccam
