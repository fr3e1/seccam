[Unit]
Description=SecCam - Self-hosted AI Security Camera
After=network.target

[Service]
Type=simple
User=seccam
Group=seccam
EnvironmentFile=/etc/seccam/seccam.env
WorkingDirectory=/opt/seccam
ExecStart=/opt/seccam/venv/bin/python -m server.main
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/seccam
ReadOnlyPaths=/opt/seccam
ProtectHome=yes
PrivateTmp=yes
MemoryMax=800M
CPUQuota=90%
Environment=OMP_NUM_THREADS=1
Nice=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=seccam

[Install]
WantedBy=multi-user.target
