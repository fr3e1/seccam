# nginx terminates TLS and forwards to SecCam on loopback.
#
# /etc/seccam/seccam.env must contain:
#   SECCAM_HOST=127.0.0.1
#   SECCAM_HTTPS_PORT=8443        (and no SECCAM_CERT / SECCAM_KEY: plain HTTP on loopback)
#   SECCAM_TRUSTED_PROXIES=127.0.0.1
#   SECCAM_PUBLIC_ORIGIN=https://cam.example.com   (mandatory behind a proxy)
#   SECCAM_COOKIE_SECURE=true

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name cam.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name cam.example.com;

    ssl_certificate     /etc/letsencrypt/live/cam.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cam.example.com/privkey.pem;

    client_max_body_size 8m;

    location /ws/ {
        proxy_pass http://127.0.0.1:8443;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:8443;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
